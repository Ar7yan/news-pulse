# =============================================================================
# .gitignore — Files that should NEVER go to GitHub
# =============================================================================

# Environment variables — NEVER commit these (contain passwords!)
.env
.env.local
.env.production
scraper/.env
backend/.env
frontend/.env.local

# Python
scraper/venv/
scraper/__pycache__/
scraper/**/__pycache__/
scraper/**/*.pyc
scraper/logs/

# Node.js
backend/node_modules/
frontend/node_modules/
backend/logs/

# Next.js build output
frontend/.next/
frontend/out/

# OS files
.DS_Store
Thumbs.db

# VS Code
.vscode/settings.json