# =============================================================================
# NEWS PULSE — Scraper Environment Variables
# =============================================================================
# HOW TO USE:
#   1. Copy this file:  copy .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to git (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE — Your PostgreSQL connection string
# -----------------------------------------------------------------------------
# Supabase format:
# postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres
#
# Local PostgreSQL format:
# postgresql://postgres:yourpassword@localhost:5432/newspulse
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/newspulse

# -----------------------------------------------------------------------------
# SCRAPER SETTINGS
# -----------------------------------------------------------------------------
# How many articles to fetch per RSS feed per run
MAX_ARTICLES_PER_FEED=50

# How long to wait (seconds) before giving up on fetching an article
REQUEST_TIMEOUT=10

# Minimum number of characters for an article to be considered valid
MIN_ARTICLE_LENGTH=200

# -----------------------------------------------------------------------------
# CLUSTERING SETTINGS
# -----------------------------------------------------------------------------
# Cosine similarity threshold (0.0 to 1.0)
# Higher = articles must be MORE similar to be grouped together
# Recommended: 0.2 to 0.3
SIMILARITY_THRESHOLD=0.25

# Maximum number of clusters to generate per run
MAX_CLUSTERS=20

# Minimum articles needed to form a cluster (singletons are noise)
MIN_CLUSTER_SIZE=2

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log to file as well as console? true/false
LOG_TO_FILE=false
LOG_FILE_PATH=logs/scraper.log